 sedang(){const r=RD([3,4,5,6,8,10]),t=RD([5,7,9,10,12]),a=2*r*(r+t);return Qn(`Tabung berjari-jari ${r} cm dan tinggi ${t} cm. Berapa luas permukaannya? (dalam π)`,a,['L = 2πr(r + t)',`L = 2π × ${r} × (${r} + ${t})`,`L = 2π × ${r} × ${r+t}`,`L = ${a}π cm²`],[2*r*t,r*(r+t),r*r+2*r*t],'π',' cm²')},
 sulit(){const r=RD([3,4,5,6]),t=RD([4,5,8,10]),V=r*r*t;return Qn(`Volume sebuah tabung adalah ${V}π cm³ dan jari-jarinya ${r} cm. Berapa tinggi tabung?`,t,['V = πr²t',`${V}π = π × ${r}² × t`,`${V} = ${r*r} × t`,`t = ${V} ÷ ${r*r} = ${t} cm`],[V/r,t*r,t+r,t*2],'',' cm')},
 cerita(){const r=RD([7,14]),t=RD([10,20,30,40,50]),c=P*r*r*t,a=c/1000;return Qn(`Sebuah drum berbentuk tabung berdiameter ${2*r} cm dan tinggi ${t} cm, diisi penuh air. Berapa liter air di dalamnya? (π = 22/7; 1 liter = 1.000 cm³)`,a,[`Jari-jari = ${2*r} ÷ 2 = ${r} cm`,`V = πr²t = 22/7 × ${r}² × ${t} = ${fmt(c)} cm³`,`Dalam liter: ${fmt(c)} ÷ 1.000 = ${fmt(a)} liter`],[a*4,a/3,a*10,a*3],'',' liter')}},
kerucut:{
