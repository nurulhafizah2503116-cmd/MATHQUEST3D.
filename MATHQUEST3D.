gabungan:{
 mudah(){const r=RD([3,6,9]),v=2*r**3/3;return Qn(`Volume sebuah belahan bola berjari-jari ${r} cm adalah … (dalam π)`,v,['V belahan = ½ × ⁴⁄₃πr³ = ⅔πr³',`V = ⅔ × π × ${r**3}`,`V = ${v}π cm³`],[4*r**3/3,2*r*r,r**3/3],'π',' cm³')},
 sedang(){const r=RD([3,6]),t=RD([4,5,10]),v=r*r*t+2*r**3/3;return Qn(`Sebuah bangun terdiri dari tabung (r = ${r} cm, t = ${t} cm) dengan belahan bola di atasnya. Berapa volumenya? (dalam π)`,v,[`V tabung = πr²t = ${r*r*t}π`,`V belahan = ⅔πr³ = ${2*r**3/3}π`,`V total = ${r*r*t}π + ${2*r**3/3}π = ${v}π cm³`],[r*r*t+4*r**3/3,r*r*t,r*r*t/3+2*r**3/3],'π',' cm³')},
 sulit(){const r=RD([3,4,5,6]),t=RD([5,8,10]),a=3*r*r+2*r*t;return Qn(`Bangun gabungan: tabung (r = ${r} cm, t = ${t} cm) dengan belahan bola di atasnya (tanpa tutup tabung). Berapa luas permukaannya? (dalam π)`,a,[`Alas = πr² = ${r*r}π`,`Selimut = 2πrt = ${2*r*t}π`,`Belahan = 2πr² = ${2*r*r}π`,`Total = ${r*r}π + ${2*r*t}π + ${2*r*r}π = ${a}π cm²`],[4*r*r+2*r*t,2*r*r+2*r*t,3*r*r+r*t],'π',' cm²')},
 cerita(){const r=21,t=RD([30,40,50]),a=P*r*r*t+2*P*r**3/3;return Qn(`Tangki berbentuk tabung (diameter 42 cm, tinggi ${t} cm) dengan penutup berbentuk belahan bola. Berapa volume tangki? (π = 22/7)`,a,['r = 42 ÷ 2 = 21 cm',`V tabung = 22/7 × 21² × ${t} = ${fmt(P*r*r*t)} cm³`,`V belahan = ⅔ × 22/7 × 21³ = ${fmt(2*P*r**3/3)} cm³`,`V total = ${fmt(a)} cm³`],[P*r*r*t+4*P*r**3/3,P*r*r*t,P*r*r*t/3+2*P*r**3/3],'',' cm³')}}};

