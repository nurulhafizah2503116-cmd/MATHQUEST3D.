 st.n++;if(ok)st.c[lvl]++;saveSt();show(Q.pick);
 const aft=BD.filter(x=>x[2](st));if(aft.length>before)toast('Lencana baru: '+aft[aft.length-1][0]+' '+aft[aft.length-1][1]);
 if($('#stv'))$('#stv').textContent='⭐ '+stars();
