/* ===== BANK SOAL ACAK ===== */
function Qn(q,a,steps,wr,suf='',u=''){const f=v=>fmt(v)+suf+u,k=new Set([f(a)]);let op=[a];
 [...wr,a*2,a+1,a*3,a+2].forEach(v=>{if(op.length<4&&v>0&&!k.has(f(v))){k.add(f(v));op.push(v)}});
 return{q,steps,opts:op.sort(()=>Math.random()-.5).map(f),ok:f(a)}}
const TRI=[[3,4,5],[5,12,13],[6,8,10],[8,15,17],[12,5,13],[9,12,15]];
