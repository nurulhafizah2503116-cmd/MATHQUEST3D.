<script>
const $=s=>document.querySelector(s),PI=Math.PI,P=22/7,U=.3,V3=(x,y,z)=>new THREE.Vector3(x,y,z);
const fmt=(n,d=2)=>(+n.toFixed(d)).toLocaleString('id-ID');
const RD=a=>a[Math.random()*a.length|0];
const SN={tabung:'Tabung',kerucut:'Kerucut',bola:'Bola',gabungan:'Gabungan'};
const NM={alas:'Alas',tutup:'Tutup',selimut:'Selimut',tinggi:'Tinggi (t)',pelukis:'Garis pelukis (s)',kulit:'Kulit bola',isi:'Isi & jari-jari',belahan:'Belahan bola'};
const PT={tabung:['alas','tutup','selimut','tinggi'],kerucut:['alas','selimut','tinggi','pelukis'],bola:['kulit','isi'],gabungan:['alas','selimut','belahan','tinggi']};
const COL={alas:'#3b82f6',tutup:'#a855f7',selimut:'#f59e0b',tinggi:'#ef4444',pelukis:'#22c55e',kulit:'#06b6d4',isi:'#ef4444',belahan:'#ec4899',jari:'#22c55e'};
let shape='tabung',r=5,t=8,sel=null,ps=0,fo=0,tab='j',lvl='mudah',Q=null,allM=[],anchors={},prof={},st={};

/* ===== KONTEN KONSEP & RUMUS ===== */
const sl=()=>Math.hypot(r,t);
const A_={s:['Alas berbentuk lingkaran dengan jari-jari r (garis hijau).','Bagi lingkaran menjadi juring-juring kecil, lalu susun berselang-seling. Hasilnya mirip persegi panjang.','Panjangnya = ½ keliling = πr, lebarnya = r. Luas = πr × r.'],f:'L alas = πr²',c:()=>`π × ${r}² = ${fmt(PI*r*r)}`};
const S_={s:['Bayangkan selimut digunting dari atas ke bawah lalu dibentangkan.','Hasilnya persegi panjang. Lebarnya = tinggi tabung (t).','Panjangnya = keliling alas = 2πr.','Luas = panjang × lebar.'],f:'L selimut = 2πrt',c:()=>`2π × ${r} × ${t} = ${fmt(2*PI*r*t)}`};
const CT={
tabung:{alas:A_,selimut:S_,
 tutup:{s:['Tutup tabung sama persis (kongruen) dengan alas.','Luas permukaan = alas + tutup + selimut.','= πr² + πr² + 2πrt, lalu difaktorkan 2πr.'],f:'L permukaan = 2πr(r + t)',c:()=>`2π × ${r} × (${r}+${t}) = ${fmt(2*PI*r*(r+t))}`},
 tinggi:{s:['Tabung dapat dipandang sebagai tumpukan lingkaran alas setinggi t.','Setiap lapisan luasnya πr².','Volume = luas alas × tinggi.'],f:'V = πr²t',c:()=>`π × ${r}² × ${t} = ${fmt(PI*r*r*t)}`}},
kerucut:{alas:{...A_,s:[...A_.s,'Luas permukaan kerucut = luas alas + luas selimut.'],f:'L alas = πr²  ;  L permukaan = πr(r + s)'},
 selimut:{s:['Gunting selimut dari puncak ke tepi alas, lalu bentangkan.','Hasilnya juring lingkaran berjari-jari s (garis pelukis).','Panjang busur juring = keliling alas = 2πr.','Luas juring = (2πr ÷ 2πs) × πs² = πrs.'],f:'L selimut = πrs',c:()=>`π × ${r} × ${fmt(sl())} = ${fmt(PI*r*sl())}`},
 tinggi:{s:['Siapkan tabung dan kerucut dengan alas & tinggi sama.','Isi kerucut dengan pasir, lalu tuang ke tabung.','Dibutuhkan 3 kali tuang sampai tabung penuh.','Jadi volume kerucut = ⅓ volume tabung.'],f:'V = ⅓πr²t',c:()=>`⅓ × π × ${r}² × ${t} = ${fmt(PI*r*r*t/3)}`},
 pelukis:{s:['Tinggi t, jari-jari r, dan garis pelukis s membentuk segitiga siku-siku.','s adalah sisi miring (hipotenusa).','Dengan Pythagoras: s² = r² + t².'],f:'s = √(r² + t²)',c:()=>`√(${r}² + ${t}²) = ${fmt(sl())}`}},
bola:{kulit:{s:['Kulit bola tidak bisa dibentangkan datar. Archimedes membandingkannya dengan lingkaran besar (luas πr²).','Kulit setengah bola ternyata menutup tepat 2 lingkaran besar.','Jadi seluruh kulit bola menutup 4 lingkaran besar.'],f:'L = 4πr²',c:()=>`4 × π × ${r}² = ${fmt(4*PI*r*r)}`},
 isi:{s:['Bayangkan tabung berjari-jari r dan tinggi 2r yang pas membungkus bola. Volumenya = πr² × 2r = 2πr³.','Archimedes menemukan: isi bola = ⅔ volume tabung pembungkusnya.','Volume bola = ⅔ × 2πr³.'],f:'V = ⁴⁄₃πr³',c:()=>`⁴⁄₃ × π × ${r}³ = ${fmt(4*PI*r**3/3)}`}},
gabungan:{alas:A_,selimut:S_,
 belahan:{s:['Belahan bola adalah setengah bola dengan jari-jari sama seperti tabung.','Luas lengkungnya = ½ × 4πr² = 2πr².','Volumenya = ½ × ⁴⁄₃πr³ = ⅔πr³.'],f:'L = 2πr²  ;  V = ⅔πr³',c:()=>`L = ${fmt(2*PI*r*r)} ; V = ${fmt(2*PI*r**3/3)}`},
 tinggi:{s:['Volume gabungan = volume tabung + volume belahan bola.','Luas permukaan = alas + selimut tabung + belahan. Tutup tabung tidak dihitung karena tertutup belahan.'],f:'V = πr²t + ⅔πr³',c:()=>`V = ${fmt(PI*r*r*t+2*PI*r**3/3)} ; L = ${fmt(3*PI*r*r+2*PI*r*t)}`}}};
function calc(){const a=PI*r*r;
 if(shape=='tabung')return[a*t,2*PI*r*(r+t)];
 if(shape=='kerucut')return[a*t/3,PI*r*(r+sl())];
 if(shape=='bola')return[4*PI*r**3/3,4*a];
 return[a*t+2*PI*r**3/3,3*a+2*PI*r*t]}

/* ===== 3D ===== */
const stage=$('#stage'),cv=$('#cv'),dot=$('#dot'),pn=$('#pn'),hint=$('#hint');
const ren=new THREE.WebGLRenderer({canvas:cv,antialias:true,alpha:true});ren.setPixelRatio(Math.min(devicePixelRatio,2));
const scene=new THREE.Scene(),cam=new THREE.PerspectiveCamera(45,1,.1,100),root=new THREE.Group();
scene.add(root,new THREE.HemisphereLight(0xffffff,0x44557a,1.05));
const dl=new THREE.DirectionalLight(0xffffff,.8);dl.position.set(5,8,6);scene.add(dl);
const grid=new THREE.GridHelper(24,24,0x4a6190,0x2c4270);grid.position.y=-4.4;scene.add(grid);
const o={th:.7,ph:1.25,d:12,tx:0,ty:0,tz:0},g={d:12,tx:0,ty:0,tz:0},cd=d=>Math.min(25,Math.max(2.5,d));
function rs(){const w=stage.clientWidth,h=stage.clientHeight;ren.setSize(w,h,false);cam.aspect=w/h;cam.updateProjectionMatrix()}
new ResizeObserver(rs).observe(stage);
function camU(){o.d+=(g.d-o.d)*.12;for(const k of['tx','ty','tz'])o[k]+=(g[k]-o[k])*.12;
 const s=Math.sin(o.ph);cam.position.set(o.tx+o.d*s*Math.sin(o.th),o.ty+o.d*Math.cos(o.ph),o.tz+o.d*s*Math.cos(o.th));cam.lookAt(o.tx,o.ty,o.tz)}
const ptr=new Map();let moved=0,pd=0;
const pdist=()=>{const a=[...ptr.values()];return a.length<2?0:Math.hypot(a[0][0]-a[1][0],a[0][1]-a[1][1])};
cv.addEventListener('pointerdown',e=>{cv.setPointerCapture(e.pointerId);ptr.set(e.pointerId,[e.clientX,e.clientY]);moved=0;pd=pdist()});
cv.addEventListener('pointermove',e=>{if(!ptr.has(e.pointerId))return;const p=ptr.get(e.pointerId);
 if(ptr.size==1){const dx=e.clientX-p[0],dy=e.clientY-p[1];moved+=Math.abs(dx)+Math.abs(dy);o.th-=dx*.01;o.ph=Math.min(3,Math.max(.2,o.ph-dy*.01))}
 ptr.set(e.pointerId,[e.clientX,e.clientY]);
 if(ptr.size==2){const d=pdist();if(pd)g.d=o.d=cd(o.d*pd/d);pd=d;moved+=10}});
cv.addEventListener('pointerup',e=>{if(ptr.size==1&&moved<6)pick(e);ptr.delete(e.pointerId)});
cv.addEventListener('pointercancel',e=>ptr.delete(e.pointerId));
cv.addEventListener('wheel',e=>{e.preventDefault();g.d=cd(g.d*(1+e.deltaY*.001))},{passive:false});
const rc=new THREE.Raycaster();
function pick(e){const b=cv.getBoundingClientRect();rc.setFromCamera({x:(e.clientX-b.left)/b.width*2-1,y:-(e.clientY-b.top)/b.height*2+1},cam);
 const h=rc.intersectObjects(allM,false);pilih(h.length?h[0].object.userData.pid:null)}

function mk(geo,pid,pos,dir,line,col){const m=new THREE.Mesh(geo,new THREE.MeshStandardMaterial({color:col||COL[pid],side:2,transparent:true,opacity:.9,roughness:.45}));
 pos=pos||V3(0,0,0);dir=dir||V3(0,0,0);m.position.copy(pos);m.userData={pid,dir,base:pos.clone(),line};
 if(!anchors[pid])anchors[pid]=pos.clone().add(dir);root.add(m);allM.push(m);return m}
function seg(a,b,pid,col){const d=b.clone().sub(a),m=mk(new THREE.CylinderGeometry(.05,.05,d.length(),8),pid,a.clone().add(b).multiplyScalar(.5),null,1,col);
 m.quaternion.setFromUnitVectors(V3(0,1,0),d.clone().normalize())}
function build(){allM.forEach(m=>{m.geometry.dispose();m.material.dispose();root.remove(m)});allM=[];anchors={};
 const R=r*U,T=t*U,h=T/2,ci=up=>new THREE.CircleGeometry(R,48).rotateX(up?-PI/2:PI/2),cy=()=>new THREE.CylinderGeometry(R,R,T,48,1,true);
 if(shape=='tabung'){mk(ci(0),'alas',V3(0,-h,0),V3(0,-1.8,0));mk(ci(1),'tutup',V3(0,h,0),V3(0,1.8,0));mk(cy(),'selimut',null,V3(R+1.6,0,0));
  seg(V3(0,-h,0),V3(0,h,0),'tinggi');seg(V3(0,-h,0),V3(R,-h,0),'alas',COL.jari)}
 else if(shape=='kerucut'){mk(ci(0),'alas',V3(0,-h,0),V3(0,-1.8,0));mk(new THREE.ConeGeometry(R,T,48,1,true),'selimut',null,V3(R+1.6,0,0));
  seg(V3(0,-h,0),V3(0,h,0),'tinggi');seg(V3(R,-h,0),V3(0,h,0),'pelukis');seg(V3(0,-h,0),V3(R,-h,0),'alas',COL.jari)}
 else if(shape=='bola'){mk(new THREE.SphereGeometry(R,48,24,0,2*PI,0,PI/2),'kulit',null,V3(0,R+.6,0));mk(new THREE.SphereGeometry(R,48,24,0,2*PI,PI/2,PI/2),'kulit',null,V3(0,-R-.6,0));
  seg(V3(0,0,0),V3(R,0,0),'isi',COL.jari);mk(new THREE.SphereGeometry(.14,16,12),'isi',null,null,1,'#ef4444')}
 else{mk(ci(0),'alas',V3(0,-h,0),V3(0,-1.8,0));mk(cy(),'selimut',null,V3(R+1.6,0,0));mk(new THREE.SphereGeometry(R,48,24,0,2*PI,0,PI/2),'belahan',V3(0,h,0),V3(0,2.2,0));
  seg(V3(0,-h,0),V3(0,h,0),'tinggi');seg(V3(0,h,0),V3(R,h,0),'belahan',COL.jari)}
 if(sel&&anchors[sel]){g.tx=anchors[sel].x;g.ty=anchors[sel].y;g.tz=anchors[sel].z}}
function loop(){requestAnimationFrame(loop);camU();
 for(const m of allM){const u=m.userData,on=sel==u.pid,tg=sel?(on?1:(u.line?.85:.15)):.9;m.material.opacity+=(tg-m.material.opacity)*.15;m.position.lerp(on?u.base.clone().add(u.dir):u.base,.15)}
 ren.render(scene,cam);place()}
function place(){if(!sel){pn.hidden=dot.hidden=hint.hidden=true;return}
 const z=o.d<8;hint.hidden=z;pn.hidden=dot.hidden=!z;if(!z)return;
 const v=anchors[sel].clone().project(cam),W=stage.clientWidth,H=stage.clientHeight,x=(v.x+1)/2*W,y=(1-v.y)/2*H;
 dot.style.left=x+'px';dot.style.top=y+'px';const w=pn.offsetWidth,h=pn.offsetHeight;
 let L=Math.min(W-w-6,Math.max(6,x-w/2)),T=y-h-14;if(T<6)T=Math.min(Math.max(6,H-h-6),y+16);pn.style.left=L+'px';pn.style.top=T+'px'}

/* ===== PILIH BAGIAN & PANEL MELAYANG ===== */
function pilih(p){sel=p;ps=0;fo=0;
 if(p){const a=anchors[p];g.tx=a.x;g.ty=a.y;g.tz=a.z;g.d=5.5;rp()}else{g.tx=g.ty=g.tz=0;g.d=12}
 chips()}
function rp(){if(!sel)return;const c=CT[shape][sel],n=c.s.length;
 let h=`<b>${NM[sel]}</b><span class=sm>${fo?'Rumus':'Konsep '+(ps+1)+'/'+n}</span>`;
 if(!fo)h+=`<p>${c.s[ps]}</p><div class=bt>${ps>0?'<button onclick="PP(-1)">‹</button>':''}${ps<n-1?'<button onclick="PP(1)">Lanjut ›</button>':'<button class=ok onclick="FF()">✔ Saya paham, tampilkan rumus</button>'}</div>`;
 else h+=`<p class=fm>${c.f}</p><p class=cl>Dengan r = ${r}${shape!='bola'?', t = '+t:''}:<br>${c.c()}</p><div class=bt><button onclick="fo=0;ps=0;rp()">↺ Ulangi konsep</button><button class=ok onclick="setTab('l')">✏️ Latihan</button></div>`;
 pn.innerHTML=h}
function PP(d){ps=Math.max(0,ps+d);rp()}function FF(){fo=1;rp()}
hint.onclick=()=>{g.d=5.5};

/* ===== TAB JELAJAH / LATIHAN ===== */
function setTab(x){tab=x;document.querySelectorAll('#tabs [data-t]').forEach(b=>b.classList.toggle('on',b.dataset.t==x));$('#sh').classList.remove('min');draw()}
document.querySelectorAll('#tabs [data-t]').forEach(b=>b.onclick=()=>setTab(b.dataset.t));
$('#mn').onclick=()=>{$('#sh').classList.toggle('min');setTimeout(rs,50)};
function draw(){tab=='j'?drawJ():drawL()}
function drawJ(){
 $('#bd').innerHTML=`<div class=row>r <input type=range id=sr min=1 max=10 value=${r}> <span id=vr>${r}</span></div>
 ${shape!='bola'?`<div class=row>t <input type=range id=stt min=1 max=15 value=${t}> <span id=vt>${t}</span></div>`:''}
 <div class=out id=out></div>
