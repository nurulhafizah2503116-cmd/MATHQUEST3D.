 sedang(){const r=RD([3,6,9,12]),v=4*r**3/3;return Qn(`Bola berjari-jari ${r} cm. Berapa volumenya? (dalam π)`,v,['V = ⁴⁄₃πr³',`V = ⁴⁄₃ × π × ${r}³ = ⁴⁄₃ × π × ${r**3}`,`V = ${v}π cm³`],[4*r*r,4*r**3,2*r**3/3],'π',' cm³')},
 sulit(){const r=RD([3,6,9,12]),v=4*r**3/3;return Qn(`Volume sebuah bola ${v}π cm³. Berapa jari-jarinya?`,r,['V = ⁴⁄₃πr³',`${v}π = ⁴⁄₃πr³  →  r³ = ${v} × ¾ = ${r**3}`,`r = ∛${r**3} = ${r} cm`],[2*r,r+3,r*r/3,r/2],'',' cm')},
