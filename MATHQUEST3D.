 sedang(){const[r,t,s]=RD(TRI);return Qn(`Kerucut berjari-jari ${r} cm dan tinggi ${t} cm. Berapa luas selimutnya? (dalam π)`,r*s,[`Garis pelukis s = √(${r}² + ${t}²) = √${r*r+t*t} = ${s} cm`,'L selimut = πrs',`L selimut = π × ${r} × ${s} = ${r*s}π cm²`],[r*t,r*(r+s),s*s],'π',' cm²')},
 sulit(){const[r,t,s]=RD(TRI),v=r*r*t/3;return Qn(`Kerucut berjari-jari ${r} cm dan garis pelukis ${s} cm. Berapa volumenya? (dalam π)`,v,[`Tinggi t = √(${s}² − ${r}²) = √${s*s-r*r} = ${t} cm`,'V = ⅓πr²t',`V = ⅓ × π × ${r*r} × ${t} = ${v}π cm³`],[r*r*s/3,r*r*t,r*t*t/3],'π',' cm³')},
 cerita(){const[r,t,s]=RD([[7,24,25],[14,48,50],[21,28,35]]),a=P*r*s;return Qn(`Topi ulang tahun berbentuk kerucut dengan diameter alas ${2*r} cm dan tinggi ${t} cm. Berapa luas minimal kertas untuk selimutnya? (π = 22/7)`,a,[`Jari-jari r = ${r} cm`,`s = √(${r}² + ${t}²) = ${s} cm`,`L selimut = πrs = 22/7 × ${r} × ${s} = ${fmt(a)} cm²`],[P*r*t,P*r*(r+s),2*P*r*s],'',' cm²')}},
bola:{
